# API (apps/api)
PORT=3333
DATABASE_URL=file:./insighthub.db
# Lista separada por virgula das origens permitidas pelo CORS
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
SYNTHESIS_LIMIT_PER_MINUTE=10
# Opcional: sem chave, a API usa o provider local deterministico
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Web (apps/web) - copie para apps/web/.env.local; sem VITE_API_URL o app roda a demo no navegador
VITE_API_URL=http://localhost:3333

# Token Bearer exigido no POST /api/surveys/:id/synthesis.
# OBRIGATORIO quando ANTHROPIC_API_KEY esta definida (minimo 16 caracteres). Gere com: openssl rand -hex 24
# INSIGHTHUB_API_TOKEN=
